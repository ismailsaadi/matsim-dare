<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>en.phm</groupId>
    <artifactId>matsim-dare</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>pt2matsim</id>
            <url>https://repo.matsim.org/repository/matsim/</url>
        </repository>
        <repository>
            <id>osgeo</id>
            <url>https://repo.osgeo.org/repository/release</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!--
              Force patched versions of vulnerable transitive dependencies.
              See D:/Downloads/maven-vulnerability-fixes.md for the full advisory list.
              Run `mvn dependency:tree -Dincludes=<group>:<artifact>` to confirm which
              direct dependency pulls in each library before tightening further.
            -->

            <!-- HIGH (CVE-2024-7254): protobuf-javalite, recursion DoS. -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-javalite</artifactId>
                <version>4.28.2</version>
            </dependency>

            <!-- MEDIUM (CVE-2021-47621, XXE): classgraph. -->
            <dependency>
                <groupId>io.github.classgraph</groupId>
                <artifactId>classgraph</artifactId>
                <version>4.8.179</version>
            </dependency>

            <!-- MEDIUM (CVE-2025-46392): commons-configuration 1.x line.
                 Long-term: migrate consumers to commons-configuration2. -->
            <dependency>
                <groupId>commons-configuration</groupId>
                <artifactId>commons-configuration</artifactId>
                <version>1.10</version>
            </dependency>

            <!--
              The following entries are placeholders pending version verification on
              mvnrepository.com — the currently-resolved versions are themselves the
              vulnerable ones, so pinning them here is a no-op until bumped. Replace
              the <version> with the latest patched release for each.
            -->

            <!-- HIGH (GHSA-72hv-8253-57qq): jackson-core. -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>2.19.2</version>
            </dependency>

            <!-- HIGH (CVE-2025-66566): lz4-java. -->
            <dependency>
                <groupId>org.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.8.0</version>
            </dependency>

            <!-- HIGH (WS-2019-0490): jcommander. -->
            <dependency>
                <groupId>com.beust</groupId>
                <artifactId>jcommander</artifactId>
                <version>1.30</version>
            </dependency>

            <!-- HIGH (CVE-2025-33042): avro. -->
            <dependency>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro</artifactId>
                <version>1.12.0</version>
            </dependency>

            <!-- MEDIUM (CVE-2026-34478, CVE-2026-34480): log4j-core. -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>2.25.1</version>
            </dependency>

            <!-- MEDIUM (CVE-2025-48924): commons-lang 2.x line.
                 Long-term: migrate consumers to commons-lang3. -->
            <dependency>
                <groupId>commons-lang</groupId>
                <artifactId>commons-lang</artifactId>
                <version>2.6</version>
            </dependency>

            <!-- MEDIUM (CVE-2025-1686): pebble. -->
            <dependency>
                <groupId>io.pebbletemplates</groupId>
                <artifactId>pebble</artifactId>
                <version>3.1.6</version>
            </dependency>

            <!-- LOW (WS-2020-0287): commons-dbcp2. -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-dbcp2</artifactId>
                <version>2.1.1</version>
            </dependency>

            <!--
              CRITICAL (GHSA-wrx5-rp7m-mm49, CVSS 9.8): commons-jxpath.
              No maintained patched version exists. Cannot be remediated with a
              version pin alone — must be removed via an <exclusion> on whichever
              direct dependency pulls it in. Run:
                  mvn dependency:tree -Dincludes=commons-jxpath:commons-jxpath
              then add an <exclusion> block to the parent in <dependencies> below.
            -->
            <dependency>
                <groupId>commons-jxpath</groupId>
                <artifactId>commons-jxpath</artifactId>
                <version>1.3</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.matsim</groupId>
            <artifactId>pt2matsim</artifactId>
            <version>25.8</version>
        </dependency>
        <dependency>
            <groupId>it.unimi.dsi</groupId>
            <artifactId>fastutil</artifactId>
            <version>8.5.18</version>
        </dependency>
        <dependency>
            <groupId>org.matsim.contrib</groupId >
            <artifactId>simwrapper</artifactId >
            <version>2025.0</version >
        </dependency>
        <!-- GeoPackage writer for ExportRoutesToGpkg. Pulls in geotools-jdbc + sqlite-jdbc.
             Excludes commons-jxpath (CRITICAL GHSA-wrx5-rp7m-mm49, no maintained patch),
             which arrives transitively via gt-xsd-core. ExportRoutesToGpkg only writes
             features through gt-geopkg / gt-jdbc — gt-xsd-core's XSD navigation paths
             that use jxpath should not be reached. Verify ExportRoutesToGpkg still
             runs after this change; if it fails with a ClassNotFoundException pointing
             at org.apache.commons.jxpath.*, remove the exclusion. -->
        <dependency>
            <groupId>org.geotools</groupId>
            <artifactId>gt-geopkg</artifactId>
            <version>33.2</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-jxpath</groupId>
                    <artifactId>commons-jxpath</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

</project>
